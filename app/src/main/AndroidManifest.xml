<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime-requested from the notification permission gate (§4.15, M6-04). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Exact dose reminders (§5.1, M6-05). Denied by default on targetSdk 33+: the user grants it
        under "Alarms & reminders", which the Settings warning row (§4.13.3) links to. Without it the
        app degrades to inexact reminders rather than failing.

        Deliberately not USE_EXACT_ALARM — that one is auto-granted but reserved for alarm-clock and
        calendar apps, and Play enforces the restriction.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".StaxApplication"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stax">

        <!--
            App Startup initializer chain (§2.3.4).

            Eager (complete before first frame):
              1. KoinInitializer   — DI graph
              2. ThemeInitializer  — DataStore theme cache read (stub until M4)

            Deferred (do real work on Lifecycle.STARTED, not at startup):
              3. RoomDatabaseInitializer  — warms DB connection (stub until M2)
              4. ExactAlarmInitializer    — mirrors exact-alarm permission into Settings (§5.1)
              5. WorkManagerInitializer   — WorkManager config + periodic jobs (stub until M0-13)
              6. FontPreloadInitializer   — measures bundled font load cost

            All deferred initializers declare KoinInitializer as a dependency so
            the DI graph is always available before they run.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <meta-data
                android:name="com.stax.app.initializer.KoinInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.stax.app.initializer.ThemeInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.stax.app.initializer.RoomDatabaseInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.stax.app.initializer.ExactAlarmInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.stax.app.initializer.WorkManagerInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.stax.app.initializer.FontPreloadInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>
</manifest>
